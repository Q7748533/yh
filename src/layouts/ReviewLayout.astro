---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import DecisionCard from '../components/DecisionCard.astro';
import ProsCons from '../components/ProsCons.astro';
import SpecTable from '../components/SpecTable.astro';
import ScoreBreakdown from '../components/ScoreBreakdown.astro';
import CtaButton from '../components/CtaButton.astro';
import Toc from '../components/Toc.astro';
import StickyBuyBar from '../components/StickyBuyBar.astro';
import { articleSchema, breadcrumbSchema, faqSchema, productReviewSchema } from '../utils/schema';
import { reviewSlug } from '../utils/seo';
import { AUTHOR_NAME } from '../consts';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data } = review;
const { Content, headings } = await review.render();

const related = (
  await getCollection('reviews', (r) => !r.data.draft && r.data.category === data.category && r.id !== review.id)
).slice(0, 3);

const hasSpecs = Object.keys(data.specs ?? {}).length > 0;
const hasBreakdown = (data.scoreBreakdown?.length ?? 0) > 0;
const hasFaq = data.faqs.length > 0;

// 目录：版式区块 + 正文标题，顺序与页面一致
const tocItems = [
  { text: 'TL;DR', slug: 'tldr', depth: 2 },
  { text: 'Pros and cons', slug: 'pros-cons', depth: 2 },
  ...(hasSpecs ? [{ text: 'Specifications', slug: 'specs', depth: 2 }] : []),
  ...(hasBreakdown ? [{ text: 'How the score breaks down', slug: 'score', depth: 2 }] : []),
  ...headings.map((h) => ({ text: h.text, slug: h.slug, depth: h.depth })),
  { text: 'Verdict', slug: 'verdict', depth: 2 },
  ...(hasFaq ? [{ text: 'Frequently asked questions', slug: 'faq', depth: 2 }] : []),
];

const jsonLd = [
  productReviewSchema({
    site: Astro.site,
    name: data.title,
    brand: data.brand,
    description: data.description,
    rating: data.rating,
    author: data.author || AUTHOR_NAME,
    path: `/reviews/${reviewSlug(review.id)}/`,
    updatedAt: data.updatedAt,
    asin: data.amazonAsin,
    priceUsd: data.priceUsd,
    priceCheckedAt: data.priceCheckedAt,
  }),
  articleSchema({
    site: Astro.site,
    headline: data.title,
    description: data.description,
    author: data.author || AUTHOR_NAME,
    path: `/reviews/${reviewSlug(review.id)}/`,
    updatedAt: data.updatedAt,
  }),
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Reviews', path: '/reviews/' },
    { name: data.product, path: `/reviews/${reviewSlug(review.id)}/` },
  ]),
  ...(hasFaq ? [faqSchema(data.faqs)] : []),
];
---

<Base
  title={data.title}
  description={data.description}
  path={`/reviews/${reviewSlug(review.id)}/`}
  ogImage={data.ogImage?.src}
  jsonLd={jsonLd}
  ogType="article"
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Reviews', href: '/reviews/' },
      { name: data.product },
    ]}
  />

  <article id="review-article" class="mx-auto max-w-5xl px-4 py-6 pb-28 md:pb-10">
    <header>
      <p class="text-sm font-medium">
        <a href={`/brands/${data.brand.toLowerCase().replace(/\s+/g, '-')}/`} class="text-blue-700 hover:underline">
          {data.brand}
        </a>
      </p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-lg text-slate-600">{data.description}</p>
      <p class="mt-3 text-sm text-slate-500">
        By <a href="/about/" class="text-slate-600 underline hover:text-slate-900">{data.author || AUTHOR_NAME}</a>
      </p>
    </header>

    <div class="mt-6">
      <DecisionCard
        rating={data.rating}
        updatedAt={data.updatedAt}
        product={data.product}
        affiliateUrl={data.affiliateUrl}
        priceUsd={data.priceUsd}
        priceCheckedAt={data.priceCheckedAt}
        amazonRating={data.amazonRating}
        sourceType={data.sourceType}
      />
    </div>

    <section id="tldr" class="mt-8">
      <h2 class="text-xs font-semibold tracking-wide text-slate-400 uppercase">TL;DR</h2>
      <p class="mt-2 text-lg leading-8 text-slate-800">{data.tldr}</p>
    </section>

    <section id="pros-cons" class="mt-8">
      <h2 class="text-2xl font-semibold text-slate-900">Pros and cons</h2>
      <ProsCons pros={data.pros} cons={data.cons} />
    </section>

    {
      hasSpecs && (
        <section id="specs" class="mt-8">
          <h2 class="text-2xl font-semibold text-slate-900">Specifications</h2>
          <SpecTable specs={data.specs} />
        </section>
      )
    }

    {
      hasBreakdown && data.scoreBreakdown && (
        <section id="score" class="mt-8">
          <h2 class="text-2xl font-semibold text-slate-900">How the {data.rating.toFixed(1)} breaks down</h2>
          <ScoreBreakdown items={data.scoreBreakdown} total={data.rating} />
        </section>
      )
    }

    <div class="mt-4">
      <CtaButton
        href={data.affiliateUrl}
        priceUsd={data.priceUsd}
        priceCheckedAt={data.priceCheckedAt}
        itemName={data.product}
      />
    </div>

    <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_200px]">
      <div>
        <Toc items={tocItems} variant="mobile" />
        <div id="article-body" class="content-body">
          <Content />
        </div>
      </div>
      <aside>
        <Toc items={tocItems} />
      </aside>
    </div>

    <section id="verdict" class="mt-12 border-t border-slate-200 pt-8">
      <h2 class="text-2xl font-semibold text-slate-900">Verdict</h2>
      <p class="mt-3 leading-7 text-slate-700">{data.verdict}</p>
      <div class="mt-4">
        <CtaButton
          href={data.affiliateUrl}
          priceUsd={data.priceUsd}
          priceCheckedAt={data.priceCheckedAt}
          itemName={data.product}
        />
      </div>
    </section>

    {
      hasFaq && (
        <section id="faq" class="mt-12">
          <h2 class="text-2xl font-semibold text-slate-900">Frequently asked questions</h2>
          <div class="mt-4 space-y-2">
            {data.faqs.map((f, i) => (
              <details class="rounded-lg border border-slate-200 px-4 py-3" open={i === 0}>
                <summary class="cursor-pointer font-semibold text-slate-900">{f.q}</summary>
                <p class="mt-2 text-sm leading-6 text-slate-700">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-semibold text-slate-900">Related reviews</h2>
          <ul class="mt-4 space-y-3">
            {related.map((r) => (
              <li class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 p-4">
                <a href={`/reviews/${reviewSlug(r.id)}/`} class="font-medium text-slate-900 hover:text-blue-700">
                  {r.data.title}
                </a>
                <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-700">
                  {r.data.rating.toFixed(1)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>

  <StickyBuyBar product={data.product} affiliateUrl={data.affiliateUrl} priceUsd={data.priceUsd} />
</Base>
