---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import RatingCard from '../components/RatingCard.astro';
import ProsCons from '../components/ProsCons.astro';
import SpecTable from '../components/SpecTable.astro';
import CtaButton from '../components/CtaButton.astro';
import AffiliateDisclosure from '../components/AffiliateDisclosure.astro';
import { articleSchema, breadcrumbSchema, faqSchema, productReviewSchema } from '../utils/schema';
import { reviewSlug } from '../utils/seo';
import { AUTHOR_NAME } from '../consts';

interface Props {
  review: CollectionEntry<'reviews'>;
}

const { review } = Astro.props;
const { data } = review;
const { Content } = await review.render();

const related = (
  await getCollection('reviews', (r) => !r.data.draft && r.data.category === data.category && r.id !== review.id)
).slice(0, 3);

const jsonLd = [
  productReviewSchema({
    site: Astro.site,
    name: data.title,
    brand: data.brand,
    description: data.description,
    rating: data.rating,
    author: data.author || AUTHOR_NAME,
    path: `/reviews/${reviewSlug(review.id)}/`,
    updatedAt: data.updatedAt,
    asin: data.amazonAsin,
    priceUsd: data.priceUsd,
    priceCheckedAt: data.priceCheckedAt,
  }),
  articleSchema({
    site: Astro.site,
    headline: data.title,
    description: data.description,
    author: data.author || AUTHOR_NAME,
    path: `/reviews/${reviewSlug(review.id)}/`,
    updatedAt: data.updatedAt,
  }),
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: 'Reviews', path: '/reviews/' },
    { name: data.product, path: `/reviews/${reviewSlug(review.id)}/` },
  ]),
  ...(data.faqs.length > 0 ? [faqSchema(data.faqs)] : []),
];
---

<Base
  title={data.title}
  description={data.description}
  path={`/reviews/${reviewSlug(review.id)}/`}
  ogImage={data.ogImage?.src}
  jsonLd={jsonLd}
  ogType="article"
>
  <Breadcrumbs
    items={[
      { name: 'Home', href: '/' },
      { name: 'Reviews', href: '/reviews/' },
      { name: data.product },
    ]}
  />

  <article class="mx-auto max-w-4xl px-4 py-6">
    <header>
      <p class="text-sm font-medium">
        <a href={`/brands/${data.brand.toLowerCase().replace(/\s+/g, '-')}/`} class="text-blue-700 hover:underline">
          {data.brand}
        </a>
      </p>
      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">{data.title}</h1>
      <p class="mt-3 text-lg text-slate-600">{data.description}</p>
      <p class="mt-3 text-sm text-slate-500">
        By <a href="/about/" class="text-slate-600 underline hover:text-slate-900">{data.author || AUTHOR_NAME}</a>
      </p>
    </header>

    <div class="mt-6">
      <RatingCard
        rating={data.rating}
        updatedAt={data.updatedAt}
        amazonRating={data.amazonRating}
        sourceType={data.sourceType}
      />
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-4">
      <CtaButton href={data.affiliateUrl} priceUsd={data.priceUsd} priceCheckedAt={data.priceCheckedAt} itemName={data.product} />
    </div>

    <AffiliateDisclosure />

    <div class="content-body mt-8">
      <Content />
    </div>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold text-slate-900">Pros and cons</h2>
      <ProsCons pros={data.pros} cons={data.cons} />
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-semibold text-slate-900">Verdict</h2>
      <p class="mt-3 leading-7 text-slate-700">{data.verdict}</p>
      <div class="mt-4">
        <CtaButton href={data.affiliateUrl} priceUsd={data.priceUsd} priceCheckedAt={data.priceCheckedAt} itemName={data.product} />
      </div>
    </section>

    {
      data.faqs.length > 0 && (
        <section class="mt-10">
          <h2 class="text-2xl font-semibold text-slate-900">Frequently asked questions</h2>
          <dl class="mt-4 space-y-4">
            {data.faqs.map((f) => (
              <div class="rounded-lg border border-slate-200 p-4">
                <dt class="font-semibold text-slate-900">{f.q}</dt>
                <dd class="mt-1 text-sm leading-6 text-slate-700">{f.a}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-slate-200 pt-8">
          <h2 class="text-2xl font-semibold text-slate-900">Related reviews</h2>
          <ul class="mt-4 space-y-3">
            {related.map((r) => (
              <li class="flex items-center justify-between gap-4 rounded-lg border border-slate-200 p-4">
                <a href={`/reviews/${reviewSlug(r.id)}/`} class="font-medium text-slate-900 hover:text-blue-700">
                  {r.data.title}
                </a>
                <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-sm font-semibold text-slate-700">
                  {r.data.rating.toFixed(1)}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>
