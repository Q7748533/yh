---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBar from '../components/ConsentBar.astro';
import ConsentBar from '../components/ConsentBar.astro';
import { SITE_NAME, SITE_TAGLINE, SITE_DESCRIPTION, GA_MEASUREMENT_ID } from '../consts';
import { absoluteUrl, truncate } from '../utils/seo';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
}

const {
  title,
  description = SITE_DESCRIPTION,
  path = '/',
  ogImage,
  noindex = false,
  jsonLd = [],
  ogType = 'website',
} = Astro.props;

const canonical = absoluteUrl(Astro.site, path);
// 标题超过 60 字符时省略站名后缀，避免 SERP 截断
const withSite = title ? `${title} | ${SITE_NAME}` : '';
const fullTitle = title
  ? withSite.length > 60
    ? title
    : withSite
  : `${SITE_NAME} — ${SITE_TAGLINE}`;
const ogImg = ogImage ? absoluteUrl(Astro.site, ogImage) : absoluteUrl(Astro.site, '/og-default.png');
const gaId = GA_MEASUREMENT_ID;
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={truncate(description)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={truncate(description)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImg} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {
      gaId && (
        <>
          <!-- Google Consent Mode v2：默认全部拒绝；接入认证 CMP（如 CookieYes）后再授权 -->
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag(){window.dataLayer.push(arguments);}
            gtag('consent', 'default', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied',
              wait_for_update: 500,
            });
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
        </>
      )
    }

    {
      cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfToken}"}`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col bg-white text-slate-800">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- GA4 转化事件：联盟外链点击（event: affiliate_click，GA4 中标记为主要转化） -->
    <script is:inline>
      document.addEventListener(
        'click',
        function (e) {
          var link = e.target && e.target.closest ? e.target.closest('a[rel~="sponsored"]') : null;
          if (!link) return;
          var domain = '';
          try {
            domain = new URL(link.href).hostname;
          } catch (err) {
            domain = '';
          }
          var payload = {
            link_url: link.href,
            link_domain: domain,
            item_name: link.getAttribute('data-item-name') || '',
            outbound: true,
          };
          if (typeof window.gtag === 'function') {
            window.gtag('event', 'affiliate_click', payload);
          } else if (window.dataLayer) {
            window.dataLayer.push(Object.assign({ event: 'affiliate_click' }, payload));
          }
        },
        true
      );
    </script>
    {gaId && <ConsentBar />}
    {gaId && <ConsentBar />}
  </body>
</html>
