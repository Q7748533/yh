---
interface Product {
  name: string;
  href?: string;
  highlight?: boolean;
}

interface Row {
  label: string;
  values: string[];
}

interface Props {
  products: Product[];
  rows: Row[];
}

const { products, rows } = Astro.props;
---

{
  products.length > 1 && rows.length > 0 && (
    <div class="my-6 overflow-x-auto">
      <table class="w-full min-w-[520px] border-collapse text-sm">
        <caption class="sr-only">Specification comparison</caption>
        <thead>
          <tr>
            <th scope="col" class="border-b border-slate-200 py-2 pr-4 text-left font-medium text-slate-500">
              Specification
            </th>
            {products.map((p) => (
              <th
                scope="col"
                class:list={[
                  'border-b border-slate-200 px-3 py-2 text-left',
                  p.highlight ? 'text-blue-700' : 'text-slate-700',
                ]}
              >
                {p.href ? <a href={p.href} class="hover:underline">{p.name}</a> : p.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row) => (
            <tr class="border-b border-slate-100">
              <th scope="row" class="py-2 pr-4 text-left font-medium text-slate-500">
                {row.label}
              </th>
              {row.values.map((v) => (
                <td class="px-3 py-2 text-slate-800">{v}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
