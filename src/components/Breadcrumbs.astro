---
interface Crumb {
  name: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-4xl px-4 pt-4 text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-1">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1">
          {i > 0 && <span class="text-slate-300">/</span>}
          {item.href ? (
            <a href={item.href} class="hover:text-slate-800">
              {item.name}
            </a>
          ) : (
            <span class="text-slate-700">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
