---
interface Props {
  rating: number;
  updatedAt: Date;
  amazonRating?: number;
  sourceType: 'tested' | 'research';
}

const { rating, updatedAt, amazonRating, sourceType } = Astro.props;

function stars(value: number) {
  const full = Math.floor(value);
  const half = value - full >= 0.5;
  return Array.from({ length: 5 }, (_, i) => (i < full ? 'full' : i === full && half ? 'half' : 'empty'));
}

const starPath =
  'M12 2l2.9 6.26 6.6.72-4.9 4.53 1.35 6.49L12 16.77 6.05 20l1.35-6.49L2.5 8.98l6.6-.72L12 2z';
---

<div class="flex flex-wrap items-center gap-6 rounded-xl border border-slate-200 bg-slate-50 p-5">
  <div class="flex items-center gap-3">
    <div class="text-4xl font-bold text-slate-900">{rating.toFixed(1)}</div>
    <div>
      <div class="flex gap-0.5" aria-label={`Our score: ${rating} out of 5`}>
        {
          stars(rating).map((type) => (
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
              <path d={starPath} class={type === 'empty' ? 'fill-slate-300' : 'fill-amber-400'} />
              {type === 'half' && (
                <path d={starPath} class="fill-slate-300" transform="translate(12,0) scale(-1,1)" />
              )}
            </svg>
          ))
        }
      </div>
      <p class="mt-1 text-xs font-medium text-slate-500">Our score</p>
    </div>
  </div>

  <div class="flex flex-wrap gap-2">
    <span
      class:list={[
        'rounded-full px-3 py-1 text-xs font-semibold',
        sourceType === 'tested' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800',
      ]}
    >
      {sourceType === 'tested' ? 'Hands-on tested' : 'Research-based review'}
    </span>
    {
      amazonRating !== undefined && (
        <span class="rounded-full bg-slate-200 px-3 py-1 text-xs font-semibold text-slate-700">
          Amazon rating: {amazonRating.toFixed(1)}/5 (reference only)
        </span>
      )
    }
  </div>

  <p class="ml-auto text-xs text-slate-500">Last updated: {updatedAt.toISOString().slice(0, 10)}</p>
</div>
