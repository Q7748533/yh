---
// 极简同意条：Consent Mode 默认 denied，用户点「接受」后才写入 analytics_storage: granted
// 选择存 localStorage，不重复弹出；拒绝后仍可正常浏览
---

<div
  id="consent-bar"
  class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white/95 backdrop-blur"
  role="dialog"
  aria-label="Cookie consent"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm leading-6 text-slate-600">
      We use analytics cookies to see which reviews get read. Nothing is set until you agree.
      <a href="/privacy/" class="underline underline-offset-2 hover:text-slate-900">Privacy policy</a>
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        type="button"
        data-consent="denied"
        class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
      >
        Decline
      </button>
      <button
        type="button"
        data-consent="granted"
        class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-slate-800"
      >
        Accept
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'tpa-consent';
    var bar = document.getElementById('consent-bar');
    if (!bar) return;

    var stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch (e) {}

    function apply(value) {
      var payload = { analytics_storage: value };
      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', payload);
      } else {
        // 兜底：即使 gtag 还没就绪（或未挂到 window），也把更新排进 dataLayer
        (window.dataLayer = window.dataLayer || []).push(['consent', 'update', payload]);
      }
      try {
        localStorage.setItem(KEY, value);
      } catch (e) {}
      bar.classList.add('hidden');
    }

    if (stored === 'granted' || stored === 'denied') {
      apply(stored);
      return;
    }

    bar.classList.remove('hidden');
    bar.querySelectorAll('[data-consent]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        apply(btn.getAttribute('data-consent'));
      });
    });
  })();
</script>
