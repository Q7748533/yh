---
// 首屏决策卡：评分 + 价格 + CTA + 披露 + 更新日，合并为一张卡（版式标准）
interface Props {
  rating: number;
  updatedAt: Date;
  product: string;
  affiliateUrl: string;
  priceUsd?: number;
  priceCheckedAt?: Date;
  listPriceUsd?: number;
  priceNote?: string;
  amazonRating?: number;
  sourceType: 'tested' | 'research';
}

const {
  rating,
  updatedAt,
  product,
  affiliateUrl,
  priceUsd,
  priceCheckedAt,
  listPriceUsd,
  priceNote,
  amazonRating,
  sourceType,
} = Astro.props;

function stars(value: number) {
  const full = Math.floor(value);
  const half = value - full >= 0.5;
  return Array.from({ length: 5 }, (_, i) => (i < full ? 'full' : i === full && half ? 'half' : 'empty'));
}

const starPath = 'M12 2l2.9 6.26 6.6.72-4.9 4.53 1.35 6.49L12 16.77 6.05 20l1.35-6.49L2.5 8.98l6.6-.72L12 2z';
const updated = updatedAt.toISOString().slice(0, 10);
---

<div data-decision-card class="rounded-xl border border-slate-300 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.04)]">
  <div class="flex items-end justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="text-4xl leading-none font-bold text-slate-900">{rating.toFixed(1)}</span>
      <div>
        <div class="flex gap-0.5" aria-label={`Our score: ${rating} out of 5`}>
          {
            stars(rating).map((type) => (
              <svg viewBox="0 0 24 24" class="h-4 w-4" aria-hidden="true">
                <path d={starPath} class={type === 'empty' ? 'fill-slate-300' : 'fill-amber-400'} />
                {type === 'half' && <path d={starPath} class="fill-slate-300" transform="translate(12,0) scale(-1,1)" />}
              </svg>
            ))
          }
        </div>
        <p class="mt-1 text-xs text-slate-500">Our score / 5</p>
      </div>
    </div>

    {
      priceUsd !== undefined && (
        <div class="text-right">
          <div class="flex items-baseline justify-end gap-2">
            <span class="text-xl font-bold text-slate-900">${priceUsd.toFixed(2)}</span>
            {listPriceUsd !== undefined && (
              <span class="text-xs text-slate-400 line-through">${listPriceUsd.toFixed(2)}</span>
            )}
          </div>
          <div class="text-xs text-slate-500">
            as of {priceCheckedAt ? priceCheckedAt.toISOString().slice(0, 10) : updated}
          </div>
        </div>
      )
    }
  </div>

  {
    priceNote && (
      <p class="mt-2 rounded bg-amber-50 px-2 py-1 text-xs font-medium text-amber-900">{priceNote}</p>
    )
  }

  <div class="mt-3 flex flex-wrap gap-2">
    <span
      class:list={[
        'rounded-full px-2.5 py-1 text-xs font-semibold',
        sourceType === 'tested' ? 'bg-green-100 text-green-800' : 'bg-blue-100 text-blue-800',
      ]}
    >
      {sourceType === 'tested' ? 'Hands-on tested' : 'Research-based'}
    </span>
    {
      amazonRating !== undefined && (
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-600">
          Amazon {amazonRating.toFixed(1)}/5 · reference only
        </span>
      )
    }
  </div>

  <a
    href={affiliateUrl}
    rel="sponsored nofollow noopener"
    target="_blank"
    data-item-name={product}
    class="mt-4 block rounded-lg bg-amber-400 px-5 py-3 text-center text-sm font-bold text-slate-900 transition hover:bg-amber-300"
  >
    Check price on Amazon
  </a>

  <p class="mt-2 text-xs leading-5 text-slate-500">
    Affiliate link · updated {updated} · we may earn a commission, which never affects the score ·{' '}
    <a href="/disclosure/" class="underline hover:text-slate-700">how we make money</a>
  </p>
</div>
