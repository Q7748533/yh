---
interface Props {
  href: string;
  priceUsd?: number;
  priceCheckedAt?: Date;
  label?: string;
  className?: string;
  itemName?: string;
  /** true = 联盟链接（rel 带 sponsored）；false = 厂商官网等中性链接 */
  isAffiliate?: boolean;
}

const {
  href,
  priceUsd,
  priceCheckedAt,
  label = 'Check price on Amazon',
  className = '',
  itemName,
  isAffiliate = true,
} = Astro.props;

const rel = isAffiliate ? 'sponsored nofollow noopener' : 'nofollow noopener';
---

<div class:list={['not-prose', className]}>
  <a
    href={href}
    rel={rel}
    target="_blank"
    data-item-name={itemName}
    data-affiliate={isAffiliate ? 'true' : 'false'}
    class:list={[
      'inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-bold transition',
      isAffiliate
        ? 'bg-amber-400 text-slate-900 hover:bg-amber-300'
        : 'border border-slate-300 bg-white text-slate-800 hover:bg-slate-50',
    ]}
  >
    {label}
    <svg viewBox="0 0 20 20" class="h-4 w-4" fill="currentColor" aria-hidden="true">
      <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z" />
      <path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z" />
    </svg>
  </a>
  {
    priceUsd !== undefined && (
      <p class="mt-1.5 text-xs text-slate-500">
        ${priceUsd.toFixed(2)}
        {priceCheckedAt && ` · price as of ${priceCheckedAt.toISOString().slice(0, 10)}`} · price may change
      </p>
    )
  }
  {
    !isAffiliate && (
      <p class="mt-1.5 text-xs text-slate-500">No affiliate link on this one — we earn nothing from it.</p>
    )
  }
</div>
