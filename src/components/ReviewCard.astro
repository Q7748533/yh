---
interface Props {
  href: string;
  brand: string;
  title: string;
  description: string;
  rating: number;
  priceUsd?: number;
  sourceType: 'tested' | 'research';
}

const { href, brand, title, description, rating, priceUsd, sourceType } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col gap-5 rounded-xl border border-slate-200 bg-white p-5 transition hover:border-slate-300 hover:bg-slate-50 sm:flex-row sm:items-center"
>
  <div class="flex shrink-0 items-baseline gap-2 sm:w-24 sm:flex-col sm:items-start sm:gap-0.5">
    <span class="text-3xl leading-none font-bold text-slate-900">{rating.toFixed(1)}</span>
    <span class="text-xs text-slate-500">out of 5</span>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold tracking-wide text-blue-700 uppercase">{brand}</span>
      <span
        class:list={[
          'rounded px-1.5 py-0.5 text-[11px] font-medium',
          sourceType === 'tested' ? 'bg-green-100 text-green-800' : 'bg-slate-100 text-slate-600',
        ]}
      >
        {sourceType === 'tested' ? 'Tested' : 'Research'}
      </span>
    </div>
    <p class="mt-1 text-lg leading-snug font-semibold text-slate-900 group-hover:text-blue-700">{title}</p>
    <p class="mt-1.5 line-clamp-2 text-sm leading-6 text-slate-600">{description}</p>
  </div>

  <div class="flex shrink-0 items-center justify-between gap-4 sm:flex-col sm:items-end sm:gap-1">
    {priceUsd !== undefined && <span class="text-base font-bold text-slate-900">${priceUsd.toFixed(0)}</span>}
    <span class="text-sm font-medium text-blue-700 group-hover:underline">Read review →</span>
  </div>
</a>
