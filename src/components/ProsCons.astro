---
interface Props {
  pros: string[];
  cons: string[];
}

const { pros, cons } = Astro.props;
---

<div class="my-6 grid gap-4 sm:grid-cols-2">
  <div class="rounded-xl border border-green-200 bg-green-50 p-5">
    <h3 class="mb-3 text-sm font-bold tracking-wide text-green-800 uppercase">Pros</h3>
    <ul class="space-y-2 text-sm text-green-900">
      {pros.map((p) => <li class="flex gap-2"><span aria-hidden="true">+</span><span>{p}</span></li>)}
    </ul>
  </div>
  <div class="rounded-xl border border-red-200 bg-red-50 p-5">
    <h3 class="mb-3 text-sm font-bold tracking-wide text-red-800 uppercase">Cons</h3>
    <ul class="space-y-2 text-sm text-red-900">
      {cons.map((c) => <li class="flex gap-2"><span aria-hidden="true">−</span><span>{c}</span></li>)}
    </ul>
  </div>
</div>
