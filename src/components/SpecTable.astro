---
// 规格表：两列自适应，移动端自动换行，不做横向滚动
interface Props {
  specs: Record<string, string>;
}

const { specs } = Astro.props;
const entries = Object.entries(specs);
---

{
  entries.length > 0 && (
    <div class="my-6 overflow-hidden rounded-lg border border-slate-200">
      <table class="w-full border-collapse text-sm">
        <caption class="sr-only">Specifications</caption>
        <tbody>
          {entries.map(([key, value], i) => (
            <tr class:list={[i % 2 === 1 && 'bg-slate-50']}>
              <th scope="row" class="w-2/5 px-4 py-2.5 text-left align-top font-medium text-slate-500">
                {key}
              </th>
              <td class="px-4 py-2.5 align-top text-slate-800">{value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
