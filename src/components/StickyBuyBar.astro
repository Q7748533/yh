---
// 移动端底部固定购买条：滚过决策卡后出现，可关闭（本会话记住）
interface Props {
  product: string;
  affiliateUrl: string;
  priceUsd?: number;
}

const { product, affiliateUrl, priceUsd } = Astro.props;
---

<div
  data-sticky-buy
  class="fixed inset-x-0 bottom-0 z-40 hidden border-t border-slate-200 bg-white px-3 py-2 md:hidden"
  role="region"
  aria-label="Buy this product"
>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="truncate text-xs text-slate-500">{product}</p>
      {priceUsd !== undefined && <p class="text-sm font-bold text-slate-900">${priceUsd.toFixed(0)}</p>}
    </div>
    <a
      href={affiliateUrl}
      rel="sponsored nofollow noopener"
      target="_blank"
      data-item-name={product}
      class="shrink-0 rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-slate-900"
    >
      Check price
    </a>
    <button type="button" data-sticky-close aria-label="Dismiss price bar" class="shrink-0 px-1 text-lg leading-none text-slate-400">
      ×
    </button>
  </div>
</div>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-sticky-buy]');
    var card = document.querySelector('[data-decision-card]');
    if (!bar || !card) return;
    try {
      if (sessionStorage.getItem('sticky-buy-dismissed') === '1') return;
    } catch (err) {}
    var visible = false;
    function show(on) {
      if (on === visible) return;
      visible = on;
      bar.classList.toggle('hidden', !on);
    }
    if (!('IntersectionObserver' in window)) return;
    var obs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          show(!e.isIntersecting && window.scrollY > 200);
        });
      },
      { threshold: 0 }
    );
    obs.observe(card);
    var close = bar.querySelector('[data-sticky-close]');
    if (close)
      close.addEventListener('click', function () {
        show(false);
        try {
          sessionStorage.setItem('sticky-buy-dismissed', '1');
        } catch (err) {}
      });
  })();
</script>
