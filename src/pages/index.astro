---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getCategoryMeta } from '../data/categoryMeta';
import { reviewSlug } from '../utils/seo';
import { SITE_NAME, SITE_TAGLINE } from '../consts';
import { itemListSchema, organizationSchema, websiteSchema } from '../utils/schema';

const reviews = (await getCollection('reviews', (r) => !r.data.draft)).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime()
);

const featured = reviews[0];
const rest = reviews.slice(1);

const categoryCounts = reviews.reduce<Record<string, number>>((acc, r) => {
  acc[r.data.category] = (acc[r.data.category] ?? 0) + 1;
  return acc;
}, {});

const brands = [...new Set(reviews.map((r) => r.data.brand))];

const scoring = [
  { name: 'Specification verification', weight: 25, note: 'Do the published numbers hold up against the source?' },
  { name: 'Capability vs. claims', weight: 30, note: 'What the tool actually does, minus the marketing.' },
  { name: 'Long-term ownership cost', weight: 20, note: 'Subscriptions, consumables, warranty terms.' },
  { name: 'Value at price', weight: 25, note: 'What the same money buys elsewhere.' },
];

const jsonLd = [
  websiteSchema(Astro.site, SITE_NAME, SITE_TAGLINE),
  organizationSchema(Astro.site, SITE_NAME),
  ...(reviews.length
    ? [
        itemListSchema(
          Astro.site,
          'Latest reviews',
          reviews.slice(0, 10).map((r) => ({ name: r.data.title, path: `/reviews/${reviewSlug(r.id)}/` }))
        ),
      ]
    : []),
];
---

<Base path="/" jsonLd={jsonLd}>
  <!-- Hero -->
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 py-14 lg:grid-cols-[1.05fr_0.95fr] lg:py-20">
      <div>
        <p class="flex items-center gap-2 text-xs font-semibold tracking-widest text-slate-500 uppercase">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-amber-400"></span>
          Independent · Research-based
        </p>
        <h1 class="mt-4 text-4xl leading-[1.1] font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-[3.4rem]">
          Product reviews that show their work.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
          We read the spec sheets, check the arithmetic, and tell you what a product costs to own — not just what it
          costs to buy. No paid placements, no invented testing.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a
            href={featured ? `/reviews/${reviewSlug(featured.id)}/` : '/reviews/'}
            class="rounded-lg bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
          >
            {featured ? 'Read the latest review' : 'Browse reviews'}
          </a>
          <a href="/methodology/" class="text-sm font-semibold text-slate-700 underline underline-offset-4 hover:text-slate-900">
            How we score
          </a>
        </div>

        <p class="mt-6 text-sm text-slate-500">
          Every page shows its sources and the date prices were checked.
        </p>
      </div>

      {
        featured && (
          <a
            href={`/reviews/${reviewSlug(featured.id)}/`}
            class="group block rounded-2xl border border-slate-200 bg-white p-6 transition hover:border-slate-300"
          >
            <div class="flex items-center justify-between">
              <span class="rounded-full bg-amber-100 px-2.5 py-1 text-[11px] font-semibold tracking-wide text-amber-900 uppercase">
                Latest review
              </span>
              <span class="text-xs text-slate-400">{featured.data.updatedAt.toISOString().slice(0, 10)}</span>
            </div>

            <p class="mt-5 text-xs font-semibold tracking-wide text-blue-700 uppercase">{featured.data.brand}</p>
            <p class="mt-1 text-xl leading-snug font-bold text-slate-900 group-hover:text-blue-700">
              {featured.data.product}
            </p>

            <div class="mt-5 flex items-end gap-4">
              <div class="flex items-baseline gap-1">
                <span class="text-5xl leading-none font-bold text-slate-900">{featured.data.rating.toFixed(1)}</span>
                <span class="text-sm text-slate-400">/ 5</span>
              </div>
              <div class="pb-1">
                <p class="text-sm font-semibold text-slate-900">
                  {featured.data.priceUsd !== undefined ? `$${featured.data.priceUsd.toFixed(0)}` : '—'}
                </p>
                <p class="text-xs text-slate-500">price checked</p>
              </div>
            </div>

            <div class="mt-5 grid grid-cols-3 gap-2 border-t border-slate-100 pt-4">
              <div>
                <p class="text-[11px] text-slate-400 uppercase">Type</p>
                <p class="mt-0.5 text-xs font-medium text-slate-700">
                  {featured.data.sourceType === 'tested' ? 'Hands-on tested' : 'Research-based'}
                </p>
              </div>
              <div>
                <p class="text-[11px] text-slate-400 uppercase">Amazon</p>
                <p class="mt-0.5 text-xs font-medium text-slate-700">
                  {featured.data.amazonRating ? `${featured.data.amazonRating.toFixed(1)}/5 ref.` : '—'}
                </p>
              </div>
              <div>
                <p class="text-[11px] text-slate-400 uppercase">Verdict</p>
                <p class="mt-0.5 text-xs font-medium text-slate-700">
                  {featured.data.rating >= 4 ? 'Recommended' : featured.data.rating >= 3 ? 'With caveats' : 'Skip'}
                </p>
              </div>
            </div>
          </a>
        )
      }
    </div>
  </section>

  <!-- Principles -->
  <section class="border-b border-slate-200 bg-white">
    <div class="mx-auto grid max-w-6xl gap-6 px-4 py-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex gap-3">
        <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" fill="currentColor" aria-hidden="true">
          <path d="M10 1l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V4l7-3zm0 2.2L5 5.3V10c0 3 2.1 5.4 5 6.8 2.9-1.4 5-3.8 5-6.8V5.3l-5-2.1z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-slate-900">Sourced claims</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Every number traces to a document you can check.</p>
        </div>
      </div>
      <div class="flex gap-3">
        <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" fill="currentColor" aria-hidden="true">
          <path d="M2 5h16v2H2V5zm0 4h10v2H2V9zm0 4h7v2H2v-2z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-slate-900">No paid placements</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Brands cannot buy a score, a ranking or a mention.</p>
        </div>
      </div>
      <div class="flex gap-3">
        <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" fill="currentColor" aria-hidden="true">
          <path d="M3 16V8h2v8H3zm4 0V4h2v12H7zm4 0v-6h2v6h-2zm4 0V6h2v10h-2z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-slate-900">Scores you can audit</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Four weighted dimensions, shown on every review.</p>
        </div>
      </div>
      <div class="flex gap-3">
        <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-slate-400" fill="currentColor" aria-hidden="true">
          <path d="M6 2h8a2 2 0 012 2v14l-6-3-6 3V4a2 2 0 012-2z" />
        </svg>
        <div>
          <p class="text-sm font-semibold text-slate-900">Dated prices</p>
          <p class="mt-1 text-sm leading-6 text-slate-600">Prices carry the date they were last checked.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest reviews -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Latest reviews</h2>
        <p class="mt-1 text-sm text-slate-600">
          {reviews.length} published · sorted by most recently updated
        </p>
      </div>
      <a href="/reviews/" class="text-sm font-semibold text-blue-700 hover:underline">All reviews →</a>
    </div>

    {
      featured && (
        <div class="mt-6 space-y-4">
          <ReviewCard
            href={`/reviews/${reviewSlug(featured.id)}/`}
            brand={featured.data.brand}
            title={featured.data.title}
            description={featured.data.description}
            rating={featured.data.rating}
            priceUsd={featured.data.priceUsd}
            sourceType={featured.data.sourceType}
          />
          {rest.map((r) => (
            <ReviewCard
              href={`/reviews/${reviewSlug(r.id)}/`}
              brand={r.data.brand}
              title={r.data.title}
              description={r.data.description}
              rating={r.data.rating}
              priceUsd={r.data.priceUsd}
              sourceType={r.data.sourceType}
            />
          ))}
        </div>
      )
    }
  </section>

  <!-- Scoring -->
  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-14">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900">How we score</h2>
          <p class="mt-1 max-w-2xl text-sm leading-6 text-slate-600">
            Every review is built from the same four weighted dimensions. The weights are published, the maths is shown
            on the page, and the total is the score in the card.
          </p>
        </div>
        <a href="/methodology/" class="text-sm font-semibold text-blue-700 hover:underline">Full methodology →</a>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          scoring.map((s, i) => (
            <div class="rounded-xl border border-slate-200 bg-white p-5">
              <div class="flex items-baseline justify-between">
                <span class="text-xs font-semibold text-slate-400">0{i + 1}</span>
                <span class="text-xs font-semibold text-slate-500">{s.weight}%</span>
              </div>
              <p class="mt-3 text-sm font-semibold text-slate-900">{s.name}</p>
              <p class="mt-1.5 text-sm leading-6 text-slate-600">{s.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Browse -->
  <section class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-2xl font-bold tracking-tight text-slate-900">Browse by category</h2>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        Object.entries(categoryCounts).map(([slug, count]) => (
          <a
            href={`/best/${slug}/`}
            class="group flex items-center justify-between gap-4 rounded-xl border border-slate-200 p-5 transition hover:border-slate-300 hover:bg-slate-50"
          >
            <div>
              <p class="text-base font-semibold text-slate-900 group-hover:text-blue-700">
                {getCategoryMeta(slug).name}
              </p>
              <p class="mt-1 text-sm text-slate-500">
                {count} review{count === 1 ? '' : 's'}
              </p>
            </div>
            <span class="text-slate-300 group-hover:text-blue-700">→</span>
          </a>
        ))
      }
      <a
        href="/brands/"
        class="group flex items-center justify-between gap-4 rounded-xl border border-slate-200 p-5 transition hover:border-slate-300 hover:bg-slate-50"
      >
        <div>
          <p class="text-base font-semibold text-slate-900 group-hover:text-blue-700">All brands</p>
          <p class="mt-1 text-sm text-slate-500">{brands.length} brand{brands.length === 1 ? '' : 's'} covered</p>
        </div>
        <span class="text-slate-300 group-hover:text-blue-700">→</span>
      </a>
    </div>
  </section>

  <!-- Closing band -->
  <section class="bg-slate-900">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 py-14 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-white">Read the reasoning, not the press release.</h2>
        <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-300">
          We tell you when a product is worth the money and when the subscription quietly doubles the price. If we get
          something wrong, correct us — every page lists when it was last updated.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 lg:justify-end">
        <a href="/reviews/" class="rounded-lg bg-white px-5 py-3 text-sm font-semibold text-slate-900 hover:bg-slate-100">
          Browse reviews
        </a>
        <a href="/contact/" class="rounded-lg border border-slate-700 px-5 py-3 text-sm font-semibold text-slate-200 hover:border-slate-500">
          Send a correction
        </a>
      </div>
    </div>
  </section>
</Base>
