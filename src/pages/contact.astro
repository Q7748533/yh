---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE_EMAIL, SITE_LEGAL_NAME } from '../consts';
---

<Base title="Contact" description="Contact our editorial team about corrections, tips and review requests." path="/contact/">
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />

  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">Contact</h1>

    <div class="content-body mt-6">
      <p>
        Corrections, tips and review requests are all welcome. We read everything and reply to corrections first.
      </p>
      <p>
        Email: <a href={`mailto:${SITE_EMAIL}`}><strong>{SITE_EMAIL}</strong></a>
      </p>

      <h2>What to include</h2>
      <ul>
        <li>For corrections: the page URL and the specific claim you believe is wrong, with a source if you have one.</li>
        <li>For review requests: the exact product model and where it is sold.</li>
        <li>For rights or data requests: which page or data you are asking about.</li>
      </ul>

      <h2>Who publishes this site</h2>
      <p>
        {SITE_LEGAL_NAME ? `${SITE_LEGAL_NAME} publishes ` : 'This site publishes '}
        independent product reviews. Our scoring method is documented on the
        <a href="/methodology/">methodology page</a>, and our commercial relationships are described in the
        <a href="/disclosure/">affiliate disclosure</a>.
      </p>
      <p>We do not accept payment for reviews, and brands cannot buy a score or a placement.</p>
    </div>
  </article>
</Base>
