---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex={true} path="/404/">
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="text-6xl font-bold text-slate-300">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-slate-900">Page not found</h1>
    <p class="mt-2 text-slate-600">The page you are looking for does not exist or has moved.</p>
    <div class="mt-8 flex justify-center gap-4 text-sm font-medium">
      <a href="/" class="text-blue-700 hover:underline">Home</a>
      <a href="/reviews/" class="text-blue-700 hover:underline">All reviews</a>
    </div>
  </div>
</Base>
