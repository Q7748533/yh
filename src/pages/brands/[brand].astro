---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaButton from '../../components/CtaButton.astro';
import { breadcrumbSchema, itemListSchema } from '../../utils/schema';
import { titleCase, reviewSlug } from '../../utils/seo';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews', (r) => !r.data.draft);
  const brands = [...new Set(reviews.map((r) => r.data.brand))];
  return brands.map((brand) => ({
    params: { brand: brand.toLowerCase().replace(/\s+/g, '-') },
    props: { brand, reviews: reviews.filter((r) => r.data.brand === brand) },
  }));
}

const { brand, reviews } = Astro.props;
const jsonLd = [
  itemListSchema(
    Astro.site,
    `${brand} reviews`,
    reviews.map((r) => ({ name: r.data.title, path: `/reviews/${reviewSlug(r.id)}/` }))
  ),
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: `${brand} reviews`, path: `/brands/${Astro.params.brand}/` },
  ]),
];

---

<Base
  title={`${brand} Reviews`}
  description={`All ${brand} product reviews and comparisons on this site.`}
  path={`/brands/${Astro.params.brand}/`}
  jsonLd={jsonLd}
>
  <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: `${brand} reviews` }]} />

  <div class="mx-auto max-w-4xl px-4 py-8">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900">{brand} reviews</h1>
    <p class="mt-2 text-slate-600">
      {reviews.length} review{reviews.length === 1 ? '' : 's'} of {brand} products, with scores, specs and buying advice.
    </p>

    <ul class="mt-8 space-y-4">
      {
        reviews.map((r) => (
          <li class="rounded-xl border border-slate-200 p-5">
            <div class="flex items-start justify-between gap-4">
              <a href={`/reviews/${reviewSlug(r.id)}/`} class="text-lg font-semibold text-slate-900 hover:text-blue-700">
                {r.data.title}
              </a>
              <span class="shrink-0 rounded-full bg-slate-100 px-3 py-1 text-sm font-bold text-slate-700">
                {r.data.rating.toFixed(1)}
              </span>
            </div>
            <p class="mt-2 text-sm text-slate-600">{r.data.description}</p>
            <div class="mt-3">
              <CtaButton href={r.data.affiliateUrl} priceUsd={r.data.priceUsd} priceCheckedAt={r.data.priceCheckedAt} itemName={r.data.product} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
