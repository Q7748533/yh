{
  "name": "review-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/qa.mjs",
    "qa": "node scripts/qa.mjs",
    "og": "node scripts/og-image.mjs",
    "serp": "node --env-file=.env scripts/serp.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=yh --branch=main --commit-dirty=true && npm run indexnow",
    "preview": "astro preview",
    "astro": "astro",
    "price": "node --env-file=.env scripts/price.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^5.18.2",
    "pagefind": "^1.5.2",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}
